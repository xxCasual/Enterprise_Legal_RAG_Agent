DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

LEGAL_RAG_LLM_MODEL=deepseek-chat
LEGAL_RAG_LLM_TIMEOUT_SECONDS=30
LEGAL_RAG_CRAG_MODE=reranker

LEGAL_RAG_STORAGE_DIR=storage
LEGAL_RAG_UPLOADS_DIR=storage/uploads
LEGAL_RAG_DOCUMENT_REGISTRY=storage/documents.json
LEGAL_RAG_PENDING_REVIEWS=storage/pending_reviews.json
LEGAL_RAG_LLAMA_LAW_CHROMA_DIR=chroma_llama_law
LEGAL_RAG_LLAMA_COMPANY_CHROMA_DIR=chroma_llama_company

# Production profile. docker-compose.prod.yml overrides hostnames for containers.
DATABASE_URL=
REDIS_URL=
CHROMA_HOST=
CHROMA_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=20
INDEXING_MAX_ATTEMPTS=3
API_AUTH_TOKEN=change-me-for-admin-apis
LOG_LEVEL=INFO
HF_ENDPOINT=https://hf-mirror.com
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
LEGAL_RAG_EMBEDDING_MODEL=/models/hf-hub/models--BAAI--bge-m3/snapshots/5617a9f61b028005a4858fdac845db406aefb181
LEGAL_RAG_RERANKER_MODEL=off
# Optional local HuggingFace cache mounts for Docker. If bge-m3 is a symlink
# under ~/.cache/huggingface/hub, point LOCAL_BGE_M3_MODEL_DIR to the real dir.
LOCAL_HF_HUB=/Users/your-name/.cache/huggingface/hub
LOCAL_BGE_M3_MODEL_DIR=/Users/your-name/.cache/huggingface/hub/models--BAAI--bge-m3

# Frontend build.
VITE_API_BASE_URL=
VITE_API_AUTH_TOKEN=change-me-for-admin-apis
