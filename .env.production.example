# Copy to .env before running docker-compose.prod.yml.
# API/worker use Compose-provided database, Redis, Chroma and upload paths.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LEGAL_RAG_LLM_MODEL=deepseek-chat
LEGAL_RAG_LLM_TIMEOUT_SECONDS=30
API_AUTH_TOKEN=replace-with-a-random-admin-token
ADMIN_SESSION_COOKIE_SECURE=0
MAX_UPLOAD_MB=20
INDEXING_MAX_ATTEMPTS=3
LEGAL_RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LEGAL_RAG_RERANKER_MODEL=off
LEGAL_RAG_CRAG_MODE=reranker
TRANSFORMERS_OFFLINE=0
HF_HUB_OFFLINE=0
HF_ENDPOINT=https://hf-mirror.com
LEGAL_RAG_WARMUP_ON_STARTUP=0
API_WORKERS=2
VITE_API_BASE_URL=
